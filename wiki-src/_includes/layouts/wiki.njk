{% set story = page[page.fileSlug] %}
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="{{ '/css/wiki.css' | url }}">
  <link
    rel="icon"
    type="image/svg+xml"
    href="{{ '/images/branding/favicon.svg' | url }}">
  <link
    rel="icon"
    href="{{ '/images/site/favicon.ico' | url }}"
    sizes="any">
  <script src="{{ '/js/nav.js' | url }}" defer></script>
</head>

<body>
  <header class="site-header">
    <div class="header-inner">
      <div class="site-branding">
        <a class="site-logo" href="{{ '/' | url }}">
          <img
            src="{{ '/images/site/logo.svg' | url }}"
            alt="">
        </a>

        <a class="site-title" href="{{ '/' | url }}">
          엑세드라 스토리 아카이브
        </a>
      </div>

      <div class="header-search" aria-label="위키 검색">
        <form method="get" action="{{ '/search.html' | url }}">
          <input
            type="search"
            name="q"
            aria-label="위키 검색어">
          <button type="submit">검색</button>
        </form>
      </div>
    </div>
  </header>

  <div id="layout">
    <nav aria-label="nav">
      <h2>둘러보기</h2>
      <a href="{{ '/' | url }}">전체 스토리 목록</a>

      <h3>목차</h3>
      <ul id="auto-toc"></ul>
    </nav>

    <main id="article-content">
      {% if story %}
      <header class="page-titlebar">
        <h1 id="firstHeading" class="firstHeading mw-first-heading" lang="ko" dir="ltr"><span class="mw-page-title-main">{{ story.title }}</span></h1>
        {% if story.subtitle %}<p class="page-subtitle">{{ story.subtitle }}</p>{% endif %}
      </header>
      {% endif %}
      {{ content | safe }}
    </main>
  </div>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <nav class="footer-places" aria-label="info">
        <a href="{{ '/' | url }}">대문</a>
        <a href="{{ '/page/0A000001.html' | url }}">면책 조항</a>
      </nav>
      <p class="footer-bottom">
        마법소녀 마도카☆마기카 Magia Exedra 스토리 아카이브
      </p>

    </div>
  </footer>
</body>
</html>
